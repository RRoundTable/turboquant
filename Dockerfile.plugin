# Plugin-only image: contains the turboquant wheel, the vLLM source patches
# (PR #39868), and an install script. NOT a runnable serving image — copy the
# files into your own vLLM image and run /opt/tq-plugin/install.sh.
#
# Usage from your own Dockerfile:
#   FROM 847366387031.dkr.ecr.ap-northeast-2.amazonaws.com/vllm-turboquant:plugin-16c6e93 AS tq
#   FROM your-vllm-image
#   COPY --from=tq /opt/tq-plugin /opt/tq-plugin
#   RUN /opt/tq-plugin/install.sh
#
# Or pull and extract:
#   docker create --name x 847366387031.dkr.ecr.ap-northeast-2.amazonaws.com/vllm-turboquant:plugin-16c6e93
#   docker cp x:/opt/tq-plugin ./tq-plugin && docker rm x

FROM scratch
COPY dist/turboquant-0.1.0-py3-none-any.whl /opt/tq-plugin/
COPY docker/vllm_patches /opt/tq-plugin/vllm_patches
COPY install.sh /opt/tq-plugin/install.sh
COPY STATUS.md /opt/tq-plugin/STATUS.md
